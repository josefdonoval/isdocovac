{
  "ConnectionStrings": {
    "DefaultConnection": "CONNECTION_STRING"
  },
  "Authentication": {
    "Session": {
      "CookieName": "SessionToken",
      "SlidingExpirationMinutes": 60,
      "AbsoluteExpirationDays": 14
    },
    "MagicLink": {
      "ExpirationMinutes": 15,
      "TokenLength": 32,
      "BaseUrl": "https://localhost:7224"
    }
  },
  "Email": {
    "Provider": "Loops",
    "Loops": {
      "ApiKey": "API_KEY",
      "TransactionalId": "cmkelzhmg07700iywc3qs0on2"
    }
  },
  "RateLimiting": {
    "MagicLink": {
      "PerEmailLimit": 3,
      "PerIpLimit": 10,
      "WindowMinutes": 15
    }
  },
  "AzureStorage": {
    "ConnectionString": "CONNECTION_STRING",
    "InvoiceContainerName": "invoice-uploads"
  },
  "Fakturoid": {
    "ClientId": "CLIENT_ID",
    "ClientSecret": "CLIENT_SECRET",
    "RedirectUri": "https://isdocovac.cz/auth/fakturoid-callback",
    "UserAgent": "Isdocovač (support@isdocovac.cz)"
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY_HERE",
    "Model": "gpt-4o",
    "MaxTokens": 4000,
    "Temperature": 0.1,
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  },
  "ISDOC": {
    "XsdSchemaUrl": "https://isdoc.cz/6.0.2/xsd/isdoc-invoice-6.0.2.xsd",
    "XsdCachePath": "./Data/isdoc-schema.xsd",
    "GeneratedIsdocContainerName": "generated-isdoc"
  },
  "Company": {
    "VatNo": "YOUR_COMPANY_VAT_NUMBER"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
