{
  "ConnectionStrings": {
    "DefaultConnection": "CONNECTION_STRING"
  },
  "Authentication": {
    "Session": {
      "CookieName": "SessionToken",
      "SlidingExpirationMinutes": 60,
      "AbsoluteExpirationDays": 14
    },
    "MagicLink": {
      "ExpirationMinutes": 15,
      "TokenLength": 32,
      "BaseUrl": "https://localhost:7224"
    }
  },
  "Email": {
    "Provider": "Loops",
    "Loops": {
      "ApiKey": "API_KEY",
      "TransactionalId": "cmkelzhmg07700iywc3qs0on2"
    }
  },
  "RateLimiting": {
    "MagicLink": {
      "PerEmailLimit": 3,
      "PerIpLimit": 10,
      "WindowMinutes": 15
    }
  },
  "AzureStorage": {
    "ConnectionString": "CONNECTION_STRING",
    "InvoiceContainerName": "invoice-uploads"
  },
  "Fakturoid": {
    "ClientId": "CLIENT_ID",
    "ClientSecret": "CLIENT_SECRET",
    "RedirectUri": "https://isdocovac.cz/auth/fakturoid-callback",
    "UserAgent": "Isdocovač (support@isdocovac.cz)"
  },
  "Claude": {
    "ApiKey": "YOUR_CLAUDE_API_KEY_HERE",
    "Model": "claude-sonnet-4-20250514",
    "MaxTokens": 4096,
    "TimeoutSeconds": 120,
    "MaxRetries": 3
  },
  "ISDOC": {
    "XsdSchemaUrl": "https://isdoc.cz/6.0.2/xsd/isdoc-invoice-6.0.2.xsd",
    "XsdCachePath": "./Data/isdoc-schema.xsd",
    "GeneratedIsdocContainerName": "generated-isdoc"
  },
  "Company": {
    "VatNo": "YOUR_COMPANY_VAT_NUMBER"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "BetterStack.Logs.Serilog",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.ClientInfo"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "BetterStack",
        "Args": {
          "sourceToken": "YOUR_BETTERSTACK_SOURCE_TOKEN",
          "betterStackEndpoint": "https://in.logs.betterstack.com"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithProcessId",
      "WithThreadId",
      "WithClientIp",
      "WithCorrelationId",
      "WithRequestHeader"
    ],
    "Properties": {
      "Application": "Isdocovac"
    }
  },
  "AllowedHosts": "*"
}
