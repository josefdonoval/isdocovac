@page "/upload-invoice"
@using System.Security.Claims
@using Isdocovac.Models.Enums
@using Isdocovac.Services
@using Isdocovac.Providers
@using Microsoft.AspNetCore.Authorization
@inject IParsedInvoiceService ParsedInvoiceService
@inject IUserProvider UserProvider
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject Isdocovac.Services.Authentication.ICurrentCompanyAccessor CurrentCompanyAccessor
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Upload Invoice</PageTitle>

<div class="container mt-4">
    <h1>Upload Invoice</h1>
    <p class="text-muted">Upload an ISDOC XML or PDF invoice file for processing</p>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <EditForm Model="@this" OnValidSubmit="HandleUpload">
                <div class="mb-3">
                    <label for="fileInput" class="form-label">Select Invoice File</label>
                    <InputFile id="fileInput" class="form-control" OnChange="HandleFileSelected" accept=".xml,.isdoc,.pdf" disabled="@isUploading" />
                    <div class="form-text">Maximum file size: 20 MB. Accepted formats: ISDOC XML (.xml, .isdoc) or PDF (.pdf)</div>
                </div>

                @if (selectedFile != null)
                {
                    <div class="alert alert-info">
                        <strong>Selected file:</strong> @selectedFile.Name (@FormatFileSize(selectedFile.Size))
                        @if (isPdfFile)
                        {
                            <span class="badge bg-primary ms-2">PDF - AI Processing</span>
                        }
                        else
                        {
                            <span class="badge bg-success ms-2">ISDOC XML</span>
                        }
                    </div>
                }

                @if (isPdfFile && selectedFile != null)
                {
                    <div class="mb-3">
                        <label class="form-label">Line Item Extraction Mode</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="lineMode" id="detailedMode"
                                   checked="@(selectedLineMode == InvoiceLineMode.Detailed)"
                                   @onchange="@(() => selectedLineMode = InvoiceLineMode.Detailed)"
                                   disabled="@isUploading" />
                            <label class="form-check-label" for="detailedMode">
                                <strong>Detailed Lines</strong> - Extract individual line items with quantities, prices, and VAT
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="lineMode" id="overallMode"
                                   checked="@(selectedLineMode == InvoiceLineMode.Overall)"
                                   @onchange="@(() => selectedLineMode = InvoiceLineMode.Overall)"
                                   disabled="@isUploading" />
                            <label class="form-check-label" for="overallMode">
                                <strong>Overall Summary</strong> - Create one summary line item with total amounts
                            </label>
                        </div>
                        <div class="form-text mt-2">
                            <strong>Detailed mode</strong> extracts every item from the invoice.
                            <strong>Overall mode</strong> creates a single summary line.
                        </div>
                    </div>
                }

                @if (isUploading)
                {
                    <div class="progress mb-3">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%">
                            Uploading...
                        </div>
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@(selectedFile == null || isUploading)">
                        @if (isUploading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Upload Invoice
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="NavigateToParsedInvoices" disabled="@isUploading">
                        View Parsed Invoices
                    </button>
                </div>
            </EditForm>
        </div>
    </div>

    <div class="mt-4">
        <h5>About Invoice Formats</h5>
        <div class="row">
            <div class="col-md-6">
                <h6>ISDOC XML</h6>
                <p class="text-muted">
                    ISDOC is an XML-based electronic invoice format recognized by the Czech Ministry of Finance.
                    XML files are validated against the ISDOC 6.0.2 schema.
                </p>
            </div>
            <div class="col-md-6">
                <h6>PDF Invoices</h6>
                <p class="text-muted">
                    PDF invoices are processed using AI to extract invoice data and generate ISDOC format.
                    The system automatically validates extracted data against ISDOC standards.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private string? errorMessage;
    private string? successMessage;
    private bool isUploading = false;
    private bool isPdfFile = false;
    private InvoiceLineMode selectedLineMode = InvoiceLineMode.Detailed;
    private const long MaxFileSize = 20 * 1024 * 1024; // 20 MB

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;
        successMessage = null;

        // Detect if PDF
        isPdfFile = IsPdfFile(selectedFile.Name);

        // Reset line mode to default
        if (isPdfFile)
        {
            selectedLineMode = InvoiceLineMode.Detailed;
        }
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
        {
            errorMessage = "Please select a file to upload.";
            return;
        }

        if (selectedFile.Size > MaxFileSize)
        {
            errorMessage = $"File size exceeds maximum allowed size of {FormatFileSize(MaxFileSize)}.";
            return;
        }

        if (!IsValidFileType(selectedFile.Name))
        {
            errorMessage = "Invalid file type. Please upload an XML or ISDOC file.";
            return;
        }

        try
        {
            isUploading = true;
            errorMessage = null;
            successMessage = null;

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity?.IsAuthenticated ?? true)
            {
                errorMessage = "You must be logged in to upload invoices.";
                isUploading = false;
                return;
            }

            var companyId = await CurrentCompanyAccessor.GetActiveCompanyIdAsync();
            if (companyId == null)
            {
                NavigationManager.NavigateTo("/companies/new", forceLoad: true);
                return;
            }

            using var stream = selectedFile.OpenReadStream(MaxFileSize);

            // Pass line mode for PDF files
            var lineMode = isPdfFile ? selectedLineMode : (InvoiceLineMode?)null;
            await ParsedInvoiceService.UploadIsdocAsync(companyId.Value, selectedFile.Name, selectedFile.Size, selectedFile.ContentType, stream, lineMode);

            if (isPdfFile)
            {
                successMessage = $"PDF invoice '{selectedFile.Name}' uploaded successfully! AI processing has started. You can view the processing status in My Invoices.";
            }
            else
            {
                successMessage = $"ISDOC invoice '{selectedFile.Name}' uploaded successfully! You can view it in My Invoices.";
            }

            selectedFile = null;
            isPdfFile = false;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading invoice: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private bool IsValidFileType(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension == ".xml" || extension == ".isdoc" || extension == ".pdf";
    }

    private bool IsPdfFile(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension == ".pdf";
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private void NavigateToParsedInvoices()
    {
        NavigationManager.NavigateTo("/isdoc/parsed");
    }
}
