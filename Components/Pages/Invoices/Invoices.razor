@page "/invoices"
@using System.Security.Claims
@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IInvoiceManagementService InvoiceManagementService
@inject NavigationManager NavigationManager
@inject Isdocovac.Services.Authentication.ICurrentCompanyAccessor CurrentCompanyAccessor
@rendermode InteractiveServer

<PageTitle>Invoices</PageTitle>

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Invoices</h1>
            <p class="text-muted">All invoices including manual, Fakturoid, and ISDOC imports</p>
        </div>
        <div class="col-auto">
            <a href="/invoices/create" class="btn btn-primary">
                <span class="bi bi-plus-circle me-2"></span>Create New Invoice
            </a>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <div class="btn-group" role="group">
                <button type="button" class="btn @(selectedDirection == null ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByDirection(null)">
                    All Invoices
                </button>
                <button type="button" class="btn @(selectedDirection == InvoiceDirection.Inbound ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByDirection(InvoiceDirection.Inbound)">
                    Inbound (Received)
                </button>
                <button type="button" class="btn @(selectedDirection == InvoiceDirection.Outbound ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => FilterByDirection(InvoiceDirection.Outbound)">
                    Outbound (Issued)
                </button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading invoices...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (!invoices.Any())
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No invoices found</h4>
            <p>You haven't created or imported any invoices yet.</p>
            <hr>
            <p class="mb-0">
                <a href="/invoices/create" class="alert-link">Create manual invoice</a>,
                <a href="/fakturoid/staging" class="alert-link">Import from Fakturoid</a>, or
                <a href="/isdoc/parsed" class="alert-link">Upload invoice files in ISDOC or PDF format</a>
            </p>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Number</th>
                                <th>Date Issued</th>
                                <th>Due Date</th>
                                <th>Client/Supplier</th>
                                <th class="text-end">Total</th>
                                <th>Status</th>
                                <th>Direction</th>
                                <th>Source</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in invoices)
                            {
                                <tr>
                                    <td>
                                        <a href="/invoices/@invoice.Id"><strong>@invoice.Number</strong></a>
                                        @if (!string.IsNullOrEmpty(invoice.CustomId))
                                        {
                                            <br><small class="text-muted">@invoice.CustomId</small>
                                        }
                                    </td>
                                    <td>@(invoice.IssuedOn?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>
                                        @if (invoice.DueOn.HasValue)
                                        {
                                            @invoice.DueOn.Value.ToString("yyyy-MM-dd")
                                            @if (invoice.Overdue)
                                            {
                                                <span class="badge bg-danger ms-1">Overdue</span>
                                            }
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        @(invoice.Direction == InvoiceDirection.Outbound ? invoice.ClientName : invoice.SupplierName)
                                    </td>
                                    <td class="text-end">
                                        <strong>@invoice.Total.ToString("N2") @invoice.Currency</strong>
                                        @if (invoice.RemainingAmount > 0 && invoice.RemainingAmount < invoice.Total)
                                        {
                                            <br><small class="text-muted">Remaining: @invoice.RemainingAmount.ToString("N2")</small>
                                        }
                                    </td>
                                    <td>
                                        @if (invoice.Paid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (invoice.Cancelled)
                                        {
                                            <span class="badge bg-secondary">Cancelled</span>
                                        }
                                        else if (invoice.Overdue)
                                        {
                                            <span class="badge bg-danger">Overdue</span>
                                        }
                                        else if (invoice.Sent)
                                        {
                                            <span class="badge bg-info">Sent</span>
                                        }
                                        else if (invoice.Open)
                                        {
                                            <span class="badge bg-warning">Open</span>
                                        }
                                    </td>
                                    <td>
                                        @if (invoice.Direction == InvoiceDirection.Inbound)
                                        {
                                            <span class="badge bg-primary">Inbound</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Outbound</span>
                                        }
                                    </td>
                                    <td>
                                        @if (invoice.Source == InvoiceSource.Fakturoid)
                                        {
                                            <span class="badge bg-info">Fakturoid</span>
                                        }
                                        else if (invoice.Source == InvoiceSource.ISDOC)
                                        {
                                            <span class="badge bg-success">ISDOC</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Manual</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button class="btn btn-primary" @onclick="() => ViewDetails(invoice.Id)">
                                                View
                                            </button>
                                            <button class="btn btn-outline-danger" @onclick="() => ConfirmDelete(invoice)">
                                                Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (totalPages > 1)
                {
                    <nav aria-label="Invoice pagination">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage - 1)" disabled="@(currentPage == 1)">
                                    Previous
                                </button>
                            </li>
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                var pageNum = i;
                                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                    <button class="page-link" @onclick="() => ChangePage(pageNum)">@pageNum</button>
                                </li>
                            }
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => ChangePage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                    Next
                                </button>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }

    <Isdocovac.Components.Shared.ConfirmDialog
        IsVisible="invoiceToDelete != null"
        Title="Confirm Deletion"
        ConfirmText="Delete"
        OnConfirm="DeleteConfirmed"
        OnCancel="CancelDelete">
        <p>Are you sure you want to delete invoice <strong>@invoiceToDelete?.Number</strong>?</p>
        <div class="alert alert-warning mb-0">
            The invoice will be marked as deleted and remain available for audit purposes.
        </div>
    </Isdocovac.Components.Shared.ConfirmDialog>
</div>

@code {
    private List<Invoice> invoices = new();
    private bool isLoading = true;
    private string? errorMessage;
    private Invoice? invoiceToDelete;
    private InvoiceDirection? selectedDirection = null;
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalInvoices = 0;
    private int totalPages = 0;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadInvoices();
    }

    private async Task LoadInvoices()
    {
        try
        {
            isLoading = true;
            errorMessage = null;

            var companyId = await CurrentCompanyAccessor.GetActiveCompanyIdAsync();
            if (companyId == null)
            {
                NavigationManager.NavigateTo("/companies/new", forceLoad: true);
                return;
            }

            invoices = (await InvoiceManagementService.GetCompanyInvoicesAsync(companyId.Value, selectedDirection, currentPage, pageSize)).ToList();
            totalInvoices = await InvoiceManagementService.GetCompanyInvoiceCountAsync(companyId.Value, selectedDirection);
            totalPages = (int)Math.Ceiling((double)totalInvoices / pageSize);
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading invoices: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task FilterByDirection(InvoiceDirection? direction)
    {
        selectedDirection = direction;
        currentPage = 1;
        await LoadInvoices();
    }

    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadInvoices();
    }

    private void ViewDetails(Guid invoiceId)
    {
        NavigationManager.NavigateTo($"/invoices/{invoiceId}");
    }

    private void ConfirmDelete(Invoice invoice)
    {
        invoiceToDelete = invoice;
    }

    private void CancelDelete()
    {
        invoiceToDelete = null;
    }

    private async Task DeleteConfirmed()
    {
        if (invoiceToDelete == null) return;

        try
        {
            await InvoiceManagementService.DeleteInvoiceAsync(invoiceToDelete.Id);
            invoiceToDelete = null;
            await LoadInvoices();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting invoice: {ex.Message}";
            invoiceToDelete = null;
        }
    }
}
