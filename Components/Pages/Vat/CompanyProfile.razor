@page "/vat/company"
@using System.ComponentModel.DataAnnotations
@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Providers
@using Isdocovac.Services.Authentication
@using Isdocovac.Services.CodeLists
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICompanyProvider CompanyProvider
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject ICodeListService CodeLists
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Company Profile (VAT)</PageTitle>

<div class="container py-4" style="max-width: 800px;">
    <h1>Company Profile</h1>
    <p class="text-muted">Údaje plátce pro přiznání k DPH a kontrolní hlášení (VetaP).</p>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger")">@statusMessage</div>
    }

    @if (model != null)
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Display name *</label>
                    <InputText class="form-control" @bind-Value="model.Name" />
                    <div class="form-text">Krátký název pro přepínač společností.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">IČO</label>
                    <InputText class="form-control" @bind-Value="model.Ico" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Typ osoby</label>
                    <select class="form-select" @bind="model.IsLegalEntity">
                        <option value="false">Fyzická osoba (F)</option>
                        <option value="true">Právnická osoba (P)</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">DIČ (bez CZ prefixu) *</label>
                    <InputText class="form-control" @bind-Value="model.Dic" />
                </div>
            </div>

            @if (model.IsLegalEntity)
            {
                <div class="mb-3">
                    <label class="form-label">Obchodní název *</label>
                    <InputText class="form-control" @bind-Value="model.CompanyName" />
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Titul</label>
                        <InputText class="form-control" @bind-Value="model.Titul" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Jméno *</label>
                        <InputText class="form-control" @bind-Value="model.FirstName" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Příjmení *</label>
                        <InputText class="form-control" @bind-Value="model.LastName" />
                    </div>
                </div>
            }

            <h5 class="mt-4">Adresa</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Ulice</label>
                    <InputText class="form-control" @bind-Value="model.Street" />
                    <div class="form-text">Nechte prázdné, pokud obec nemá ulice (FÚ akceptuje jen obec + č.p.).</div>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Č. popisné *</label>
                    <InputText class="form-control" @bind-Value="model.HouseNumber" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Č. orientační</label>
                    <InputText class="form-control" @bind-Value="model.OrientNumber" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Obec *</label>
                    <InputText class="form-control" @bind-Value="model.City" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">PSČ *</label>
                    <InputText class="form-control" @bind-Value="model.Zip" />
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Stát (ISO2)</label>
                    <InputText class="form-control" @bind-Value="model.CountryCode" />
                </div>
            </div>

            <h5 class="mt-4">Kontakt</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">E-mail *</label>
                    <InputText type="email" class="form-control" @bind-Value="model.Email" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Telefon</label>
                    <InputText class="form-control" @bind-Value="model.Phone" />
                </div>
            </div>

            <h5 class="mt-4">Finanční úřad + evidence</h5>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Finanční úřad (c_ufo) *</label>
                    <InputSelect class="form-select" @bind-Value="model.TaxOfficeCode"
                                 @bind-Value:after="OnTaxOfficeChanged">
                        <option value="">-- vyberte --</option>
                        @foreach (var office in CodeLists.TaxOffices)
                        {
                            <option value="@office.CUfo">@office.CUfo — @office.Nazev</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Územní pracoviště (c_pracufo)</label>
                    <InputSelect class="form-select" @bind-Value="model.TaxOfficeBranchCode"
                                 disabled="@(model.TaxOfficeCode == null)">
                        <option value="">-- vyberte --</option>
                        @foreach (var branch in CodeLists.GetBranchesFor(model.TaxOfficeCode))
                        {
                            <option value="@branch.CPracufo">@branch.CPracufo — @branch.Nazev</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">CZ-NACE sekce (c_okec)</label>
                    <InputSelect class="form-select" @bind-Value="model.OkecCode">
                        <option value="">-- vyberte --</option>
                        @foreach (var nace in CodeLists.NaceSections)
                        {
                            <option value="@nace.Sekce">@nace.Sekce — @nace.NazevCz</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">ID datové schránky</label>
                    <InputText class="form-control" @bind-Value="model.DataBoxId" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Zdaňovací období DPH *</label>
                    <InputSelect class="form-select" @bind-Value="model.VatPeriod">
                        <option value="@VatPeriod.Monthly">Měsíční</option>
                        <option value="@VatPeriod.Quarterly">Čtvrtletní</option>
                    </InputSelect>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@saving">
                    @(saving ? "Ukládám…" : "Uložit")
                </button>
                @if (!string.IsNullOrEmpty(returnUrl))
                {
                    <a href="@returnUrl" class="btn btn-outline-secondary">Zpět</a>
                }
            </div>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery]
    private string? returnUrl { get; set; }

    private CompanyFormModel? model;
    private Company? company;
    private bool saving;
    private string? statusMessage;
    private bool statusSuccess;

    protected override async Task OnInitializedAsync()
    {
        company = await CurrentCompanyAccessor.GetActiveCompanyAsync();
        if (company == null)
        {
            NavigationManager.NavigateTo("/companies/new", forceLoad: true);
            return;
        }

        model = CompanyFormModel.From(company);
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            if (company == null) return;
            model!.ApplyTo(company);
            await CompanyProvider.UpdateAsync(company);
            statusSuccess = true;
            statusMessage = "Uloženo.";
            if (!string.IsNullOrEmpty(returnUrl))
            {
                NavigationManager.NavigateTo(returnUrl);
            }
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Chyba: {ex.Message}";
        }
        finally
        {
            saving = false;
        }
    }

    private void OnTaxOfficeChanged()
    {
        if (model == null) return;
        var branches = CodeLists.GetBranchesFor(model.TaxOfficeCode);
        if (model.TaxOfficeBranchCode.HasValue
            && branches.All(b => b.CPracufo != model.TaxOfficeBranchCode.Value))
        {
            model.TaxOfficeBranchCode = null;
        }
    }

    public class CompanyFormModel
    {
        [Required] public string Name { get; set; } = string.Empty;
        public bool IsLegalEntity { get; set; } = true;
        [Required] public string? Dic { get; set; }
        public string? Ico { get; set; }
        public string? CompanyName { get; set; }
        public string? FirstName { get; set; }
        public string? LastName { get; set; }
        public string? Titul { get; set; }
        public string? Street { get; set; }
        [Required] public string? HouseNumber { get; set; }
        public string? OrientNumber { get; set; }
        [Required] public string? City { get; set; }
        [Required] public string? Zip { get; set; }
        public string CountryCode { get; set; } = "CZ";
        [Required, EmailAddress] public string? Email { get; set; }
        public string? Phone { get; set; }
        [Required] public int? TaxOfficeCode { get; set; }
        public int? TaxOfficeBranchCode { get; set; }
        public string? OkecCode { get; set; }
        public string? DataBoxId { get; set; }
        public VatPeriod VatPeriod { get; set; } = VatPeriod.Monthly;

        public static CompanyFormModel From(Company c) => new()
        {
            Name = c.Name,
            IsLegalEntity = c.IsLegalEntity,
            Dic = c.Dic,
            Ico = c.Ico,
            CompanyName = c.CompanyName,
            FirstName = c.FirstName,
            LastName = c.LastName,
            Titul = c.Titul,
            Street = c.Street,
            HouseNumber = c.HouseNumber,
            OrientNumber = c.OrientNumber,
            City = c.City,
            Zip = c.Zip,
            CountryCode = c.CountryCode,
            Email = c.Email,
            Phone = c.Phone,
            TaxOfficeCode = c.TaxOfficeCode,
            TaxOfficeBranchCode = c.TaxOfficeBranchCode,
            OkecCode = c.OkecCode,
            DataBoxId = c.DataBoxId,
            VatPeriod = c.VatPeriod,
        };

        public void ApplyTo(Company c)
        {
            c.Name = Name;
            c.IsLegalEntity = IsLegalEntity;
            c.Dic = Dic;
            c.Ico = Ico;
            c.CompanyName = CompanyName;
            c.FirstName = FirstName;
            c.LastName = LastName;
            c.Titul = Titul;
            c.Street = Street;
            c.HouseNumber = HouseNumber;
            c.OrientNumber = OrientNumber;
            c.City = City;
            c.Zip = Zip;
            c.CountryCode = string.IsNullOrWhiteSpace(CountryCode) ? "CZ" : CountryCode.ToUpperInvariant();
            c.Email = Email;
            c.Phone = Phone;
            c.TaxOfficeCode = TaxOfficeCode;
            c.TaxOfficeBranchCode = TaxOfficeBranchCode;
            c.OkecCode = OkecCode;
            c.DataBoxId = DataBoxId;
            c.VatPeriod = VatPeriod;
        }
    }
}
