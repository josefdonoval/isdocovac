@page "/vat/monthly"
@using System.Security.Claims
@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Models.Vat
@using Isdocovac.Providers
@using Isdocovac.Services.Vat
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject Isdocovac.Services.Authentication.ICurrentCompanyAccessor CurrentCompanyAccessor
@inject IMainInvoiceProvider InvoiceProvider
@inject IVatCalculationService VatCalculationService
@inject IDphXmlGeneratorService DphGenerator
@inject IKhXmlGeneratorService KhGenerator
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>DPH</PageTitle>

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(-1)" disabled="@busy">‹</button>
        <div class="border rounded px-3 py-1 fw-semibold">@year</div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(1)" disabled="@busy">›</button>
        <span class="ms-3 small text-muted">
            Zdaňovací období: <strong>@(vatPeriod == VatPeriod.Quarterly ? "Čtvrtletní" : "Měsíční")</strong>
            <a class="ms-2" href="/vat/company?returnUrl=/vat/monthly">změnit</a>
        </span>
    </div>

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="alert alert-info">@infoMessage</div>
    }
    @if (errors.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>Chyby validace:</strong>
            <ul class="mb-0">
                @foreach (var err in errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @if (missingDuzp.Count > 0)
    {
        <div class="alert alert-warning">
            <strong>Chybí DUZP (@missingDuzp.Count):</strong>
            <ul class="mb-0">
                @foreach (var inv in missingDuzp)
                {
                    <li>
                        @(inv.Direction == InvoiceDirection.Outbound ? "Vydaná" : "Přijatá")
                        <a href="/invoices/@inv.Id">@inv.Number</a> — @(inv.IssuedOn?.ToString("yyyy-MM-dd") ?? "?")
                        @if (inv.Direction == InvoiceDirection.Inbound && !string.IsNullOrWhiteSpace(inv.SupplierVatNo))
                        {
                            <span> (dodavatel plátce DPH: @inv.SupplierVatNo)</span>
                        }
                    </li>
                }
            </ul>
            <div class="small mt-1">Tyto faktury vyžadují DUZP a nezapočítají se do DPH dokud nebude vyplněna.</div>
        </div>
    }

    @if (vatPeriod == VatPeriod.Quarterly)
    {
        <div class="list-group mb-3">
            @for (var q = 1; q <= 4; q++)
            {
                var quarter = q;
                var isCurrent = year == DateTime.Now.Year && IsCurrentQuarter(quarter);
                <div class="list-group-item d-flex align-items-center justify-content-between @(isCurrent ? "bg-warning-subtle" : "")">
                    <div class="fw-medium">@quarter. čtvrtletí @year (@QuarterLabel(quarter))</div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GenerateQuarterDphAsync(year, quarter)" disabled="@busy">DPH</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GenerateQuarterKhAsync(year, quarter)" disabled="@busy">Kontrolní hlášení</button>
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                @onclick="() => PreviewQuarterAsync(year, quarter)" disabled="@busy">Náhled</button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @for (var q = 1; q <= 4; q++)
        {
            var quarter = q;
            <h3 class="mt-4">@quarter. čtvrtletí @year</h3>
            <div class="list-group mb-3">
                @for (var mi = 0; mi < 3; mi++)
                {
                    var m = (quarter - 1) * 3 + mi + 1;
                    var isCurrent = year == DateTime.Now.Year && m == DateTime.Now.Month;
                    <div class="list-group-item d-flex align-items-center justify-content-between @(isCurrent ? "bg-warning-subtle" : "")">
                        <div class="fw-medium">@MonthName(m)</div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => GenerateDphAsync(year, m)" disabled="@busy">DPH</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    @onclick="() => GenerateKhAsync(year, m)" disabled="@busy">Kontrolní hlášení</button>
                            <button type="button" class="btn btn-outline-primary btn-sm"
                                    @onclick="() => PreviewAsync(year, m)" disabled="@busy">Náhled</button>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @if (report != null)
    {
        <h4 class="mt-4">Souhrn — @PeriodLabel(report)</h4>
        <div class="table-responsive">
            <table class="table table-sm">
                <tbody>
                    <tr><th>Obrat 21 % (ř. 1)</th><td>@Fmt(report.Obrat23) Kč</td><th>Daň 21 %</th><td>@Fmt(report.Dan23) Kč</td></tr>
                    <tr><th>Obrat 12 % (ř. 2)</th><td>@Fmt(report.Obrat5) Kč</td><th>Daň 12 %</th><td>@Fmt(report.Dan5) Kč</td></tr>
                    <tr><th>Služby z EU (ř. 5)</th><td>@Fmt(report.PSl23Eu) Kč</td><th>Daň</th><td>@Fmt(report.DanPSl23Eu) Kč</td></tr>
                    <tr><th>Služby mimo EU (ř. 12)</th><td>@Fmt(report.PSl23NonEu) Kč</td><th>Daň</th><td>@Fmt(report.DanPSl23NonEu) Kč</td></tr>
                    <tr><th>Tuzemské vstupy 21 % (ř. 40)</th><td>@Fmt(report.Pln23) Kč</td><th>Odpočet</th><td>@Fmt(report.OdpTuz23) Kč</td></tr>
                    <tr><th>Reverse charge odpočet (ř. 43)</th><td>@Fmt(report.NarZdp23) Kč</td><th>Odpočet</th><td>@Fmt(report.OdZdp23) Kč</td></tr>
                    <tr class="table-active"><th>Daň na výstupu celkem (ř. 62)</th><td>@Fmt(report.DanZocelk) Kč</td><th>Odpočet celkem (ř. 63)</th><td>@Fmt(report.OdpZocelk) Kč</td></tr>
                    <tr class="table-warning"><th>Daň k úhradě (ř. 64)</th><td>@Fmt(report.DanoDa) Kč</td><th>Nadměrný odpočet (ř. 65)</th><td>@Fmt(report.DanoNo) Kč</td></tr>
                </tbody>
            </table>
        </div>
        <div class="small text-muted">
            KH rows: A2 = @report.A2Rows.Count, A4 = @report.A4Rows.Count, B2 = @report.B2Rows.Count.
            A5 agregát: @Fmt(report.A5Aggregate.Base23) Kč, B3 agregát: @Fmt(report.B3Aggregate.Base23) Kč.
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private int year = DateTime.Now.Year;
    private bool busy;
    private string? infoMessage;
    private List<string> errors = new();
    private VatMonthlyReport? report;
    private VatPeriod vatPeriod = VatPeriod.Monthly;
    private List<Invoice> missingDuzp = new();

    private Company? activeCompany;

    protected override async Task OnInitializedAsync()
    {
        activeCompany = await CurrentCompanyAccessor.GetActiveCompanyAsync();
        if (activeCompany == null)
        {
            NavigationManager.NavigateTo("/companies/new", forceLoad: true);
            return;
        }
        vatPeriod = activeCompany.VatPeriod;
        await LoadMissingDuzpAsync(activeCompany.Id);
    }

    private async Task LoadMissingDuzpAsync(Guid companyId)
    {
        var list = await InvoiceProvider.GetInvoicesMissingRequiredDuzpAsync(companyId, year);
        missingDuzp = list.ToList();
    }

    private async Task ChangeYear(int delta)
    {
        year += delta;
        report = null;
        infoMessage = null;
        errors.Clear();
        if (activeCompany != null)
        {
            await LoadMissingDuzpAsync(activeCompany.Id);
        }
    }

    private async Task<VatMonthlyReport?> BuildReportAsync(int y, int m)
    {
        errors.Clear();
        infoMessage = null;

        if (activeCompany == null) return null;

        var invoices = await InvoiceProvider.GetVatMonthInvoicesAsync(activeCompany.Id, y, m);
        if (invoices.Count == 0)
        {
            infoMessage = $"Žádné faktury pro {MonthName(m)} {y}.";
            return null;
        }

        try
        {
            return await VatCalculationService.BuildAsync(invoices, activeCompany, y, m);
        }
        catch (VatExportValidationException ex)
        {
            errors.AddRange(ex.Errors);
            return null;
        }
    }

    private async Task<VatMonthlyReport?> BuildQuarterReportAsync(int y, int q)
    {
        errors.Clear();
        infoMessage = null;

        if (activeCompany == null) return null;

        var invoices = await InvoiceProvider.GetVatQuarterInvoicesAsync(activeCompany.Id, y, q);
        if (invoices.Count == 0)
        {
            infoMessage = $"Žádné faktury pro {q}. čtvrtletí {y}.";
            return null;
        }

        try
        {
            return await VatCalculationService.BuildQuarterAsync(invoices, activeCompany, y, q);
        }
        catch (VatExportValidationException ex)
        {
            errors.AddRange(ex.Errors);
            return null;
        }
    }

    private async Task PreviewAsync(int y, int m)
    {
        busy = true;
        try { report = await BuildReportAsync(y, m); }
        finally { busy = false; }
    }

    private async Task PreviewQuarterAsync(int y, int q)
    {
        busy = true;
        try { report = await BuildQuarterReportAsync(y, q); }
        finally { busy = false; }
    }

    private async Task GenerateDphAsync(int y, int m)
    {
        busy = true;
        try
        {
            report = await BuildReportAsync(y, m);
            if (report == null) return;
            var xml = DphGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"dph-{y}-{m}m.xml", xml, "application/xml");
            infoMessage = $"DPH pro {MonthName(m)} {y} staženo.";
        }
        finally { busy = false; }
    }

    private async Task GenerateQuarterDphAsync(int y, int q)
    {
        busy = true;
        try
        {
            report = await BuildQuarterReportAsync(y, q);
            if (report == null) return;
            var xml = DphGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"dph-{y}-Q{q}.xml", xml, "application/xml");
            infoMessage = $"DPH pro {q}. čtvrtletí {y} staženo.";
        }
        finally { busy = false; }
    }

    private async Task GenerateKhAsync(int y, int m)
    {
        busy = true;
        try
        {
            report = await BuildReportAsync(y, m);
            if (report == null) return;
            var xml = KhGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"kontrolni_hlaseni-{y}-{m}m.xml", xml, "application/xml");
            infoMessage = $"Kontrolní hlášení pro {MonthName(m)} {y} staženo.";
        }
        finally { busy = false; }
    }

    private async Task GenerateQuarterKhAsync(int y, int q)
    {
        busy = true;
        try
        {
            report = await BuildQuarterReportAsync(y, q);
            if (report == null) return;
            var xml = KhGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"kontrolni_hlaseni-{y}-Q{q}.xml", xml, "application/xml");
            infoMessage = $"Kontrolní hlášení pro {q}. čtvrtletí {y} staženo.";
        }
        finally { busy = false; }
    }

    private static readonly string[] MonthNames =
    {
        "Leden", "Únor", "Březen", "Duben", "Květen", "Červen",
        "Červenec", "Srpen", "Září", "Říjen", "Listopad", "Prosinec"
    };

    private static string MonthName(int m) => MonthNames[m - 1];

    private static string QuarterLabel(int q) => q switch
    {
        1 => "leden–březen",
        2 => "duben–červen",
        3 => "červenec–září",
        4 => "říjen–prosinec",
        _ => string.Empty,
    };

    private static bool IsCurrentQuarter(int q)
    {
        var m = DateTime.Now.Month;
        return q == ((m - 1) / 3) + 1;
    }

    private static string PeriodLabel(VatMonthlyReport r)
        => r.IsQuarterly ? $"{r.Quarter}. čtvrtletí {r.Year}" : $"{MonthName(r.Month)} {r.Year}";

    private static string Fmt(decimal value) =>
        value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("cs-CZ"));
}
