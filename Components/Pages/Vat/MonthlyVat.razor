@page "/vat/monthly"
@using System.Security.Claims
@using Isdocovac.Models.Vat
@using Isdocovac.Providers
@using Isdocovac.Services.Vat
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@attribute [Authorize]
@inject IContactProvider ContactProvider
@inject IMainInvoiceProvider InvoiceProvider
@inject IVatCalculationService VatCalculationService
@inject IDphXmlGeneratorService DphGenerator
@inject IKhXmlGeneratorService KhGenerator
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Monthly VAT</PageTitle>

<div class="container py-4" style="max-width: 1100px;">
    <div class="d-flex align-items-center gap-2 mb-4">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(-1)" disabled="@busy">‹</button>
        <div class="border rounded px-3 py-1 fw-semibold">@year</div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(1)" disabled="@busy">›</button>
    </div>

    @if (!string.IsNullOrEmpty(infoMessage))
    {
        <div class="alert alert-info">@infoMessage</div>
    }
    @if (errors.Count > 0)
    {
        <div class="alert alert-danger">
            <strong>Chyby validace:</strong>
            <ul class="mb-0">
                @foreach (var err in errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    @for (var q = 1; q <= 4; q++)
    {
        var quarter = q;
        <h3 class="mt-4">@quarter. čtvrtletí @year</h3>
        <div class="list-group mb-3">
            @for (var mi = 0; mi < 3; mi++)
            {
                var m = (quarter - 1) * 3 + mi + 1;
                var isCurrent = year == DateTime.Now.Year && m == DateTime.Now.Month;
                <div class="list-group-item d-flex align-items-center justify-content-between @(isCurrent ? "bg-warning-subtle" : "")">
                    <div class="fw-medium">@MonthName(m)</div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GenerateDphAsync(year, m)" disabled="@busy">DPH</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm"
                                @onclick="() => GenerateKhAsync(year, m)" disabled="@busy">Kontrolní hlášení</button>
                        <button type="button" class="btn btn-outline-primary btn-sm"
                                @onclick="() => PreviewAsync(year, m)" disabled="@busy">Náhled</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (report != null)
    {
        <h4 class="mt-4">Souhrn — @MonthName(report.Month) @report.Year</h4>
        <div class="table-responsive">
            <table class="table table-sm">
                <tbody>
                    <tr><th>Obrat 21 % (ř. 1)</th><td>@Fmt(report.Obrat23) Kč</td><th>Daň 21 %</th><td>@Fmt(report.Dan23) Kč</td></tr>
                    <tr><th>Obrat 12 % (ř. 2)</th><td>@Fmt(report.Obrat5) Kč</td><th>Daň 12 %</th><td>@Fmt(report.Dan5) Kč</td></tr>
                    <tr><th>Služby z EU (ř. 5)</th><td>@Fmt(report.PSl23Eu) Kč</td><th>Daň</th><td>@Fmt(report.DanPSl23Eu) Kč</td></tr>
                    <tr><th>Služby mimo EU (ř. 12)</th><td>@Fmt(report.PSl23NonEu) Kč</td><th>Daň</th><td>@Fmt(report.DanPSl23NonEu) Kč</td></tr>
                    <tr><th>Tuzemské vstupy 21 % (ř. 40)</th><td>@Fmt(report.Pln23) Kč</td><th>Odpočet</th><td>@Fmt(report.OdpTuz23) Kč</td></tr>
                    <tr><th>Reverse charge odpočet (ř. 43)</th><td>@Fmt(report.NarZdp23) Kč</td><th>Odpočet</th><td>@Fmt(report.OdZdp23) Kč</td></tr>
                    <tr class="table-active"><th>Daň na výstupu celkem (ř. 62)</th><td>@Fmt(report.DanZocelk) Kč</td><th>Odpočet celkem (ř. 63)</th><td>@Fmt(report.OdpZocelk) Kč</td></tr>
                    <tr class="table-warning"><th>Daň k úhradě (ř. 64)</th><td>@Fmt(report.DanoDa) Kč</td><th>Nadměrný odpočet (ř. 65)</th><td>@Fmt(report.DanoNo) Kč</td></tr>
                </tbody>
            </table>
        </div>
        <div class="small text-muted">
            KH rows: A2 = @report.A2Rows.Count, A4 = @report.A4Rows.Count, B2 = @report.B2Rows.Count.
            A5 agregát: @Fmt(report.A5Aggregate.Base23) Kč, B3 agregát: @Fmt(report.B3Aggregate.Base23) Kč.
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private int year = DateTime.Now.Year;
    private bool busy;
    private string? infoMessage;
    private List<string> errors = new();
    private VatMonthlyReport? report;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateTask!;
        var claim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim == null || !Guid.TryParse(claim.Value, out var uid))
        {
            NavigationManager.NavigateTo("/auth/login");
            return;
        }

        var own = await ContactProvider.GetOwnCompanyAsync(uid);
        if (own == null)
        {
            NavigationManager.NavigateTo("/vat/company?returnUrl=/vat/monthly");
        }
    }

    private void ChangeYear(int delta)
    {
        year += delta;
        report = null;
        infoMessage = null;
        errors.Clear();
    }

    private async Task<VatMonthlyReport?> BuildReportAsync(int y, int m)
    {
        errors.Clear();
        infoMessage = null;

        var authState = await AuthenticationStateTask!;
        var userId = Guid.Parse(authState.User.FindFirst(ClaimTypes.NameIdentifier)!.Value);

        var own = await ContactProvider.GetOwnCompanyAsync(userId);
        if (own == null)
        {
            NavigationManager.NavigateTo("/vat/company?returnUrl=/vat/monthly");
            return null;
        }

        var invoices = await InvoiceProvider.GetVatMonthInvoicesAsync(userId, y, m);
        if (invoices.Count == 0)
        {
            infoMessage = $"Žádné faktury pro {MonthName(m)} {y}.";
            return null;
        }

        try
        {
            return await VatCalculationService.BuildAsync(invoices, own, y, m);
        }
        catch (VatExportValidationException ex)
        {
            errors.AddRange(ex.Errors);
            return null;
        }
    }

    private async Task PreviewAsync(int y, int m)
    {
        busy = true;
        try { report = await BuildReportAsync(y, m); }
        finally { busy = false; }
    }

    private async Task GenerateDphAsync(int y, int m)
    {
        busy = true;
        try
        {
            report = await BuildReportAsync(y, m);
            if (report == null) return;
            var xml = DphGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"dph-{y}-{m}m.xml", xml, "application/xml");
            infoMessage = $"DPH pro {MonthName(m)} {y} staženo.";
        }
        finally { busy = false; }
    }

    private async Task GenerateKhAsync(int y, int m)
    {
        busy = true;
        try
        {
            report = await BuildReportAsync(y, m);
            if (report == null) return;
            var xml = KhGenerator.Generate(report);
            await JS.InvokeVoidAsync("isdocovacDownload.downloadText",
                $"kontrolni_hlaseni-{y}-{m}m.xml", xml, "application/xml");
            infoMessage = $"Kontrolní hlášení pro {MonthName(m)} {y} staženo.";
        }
        finally { busy = false; }
    }

    private static readonly string[] MonthNames =
    {
        "Leden", "Únor", "Březen", "Duben", "Květen", "Červen",
        "Červenec", "Srpen", "Září", "Říjen", "Listopad", "Prosinec"
    };

    private static string MonthName(int m) => MonthNames[m - 1];

    private static string Fmt(decimal value) =>
        value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("cs-CZ"));
}
