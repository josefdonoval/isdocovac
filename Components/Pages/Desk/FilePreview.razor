@using Isdocovac.Models.Inbox

@if (File != null)
{
    <div class="modal d-block" tabindex="-1" role="dialog" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@File.FileName</h5>
                    @if (SasUrl != null)
                    {
                        <a href="@SasUrl" class="btn btn-sm btn-outline-primary ms-3" target="_blank" rel="noopener noreferrer">
                            Otevřít v novém okně
                        </a>
                    }
                    <button type="button" class="btn-close" @onclick="OnClose"></button>
                </div>
                <div class="modal-body">
                    @{
                        var ext = Path.GetExtension(File.FileName).ToLowerInvariant();
                        var ct = (File.ContentType ?? string.Empty).ToLowerInvariant();
                        var isPdf = ct.Contains("pdf") || ext == ".pdf";
                        var isImage = (ct.StartsWith("image/") && !ct.Contains("svg")) ||
                                      ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif";
                        var isXml = ext is ".xml" or ".isdoc" or ".isdocx";
                    }

                    @if (!string.IsNullOrEmpty(ErrorMessage))
                    {
                        <div class="alert alert-danger">
                            <strong>Náhled se nepodařilo načíst:</strong> @ErrorMessage
                        </div>
                    }
                    else if (isPdf && SasUrl != null)
                    {
                        @* SAS URL goes to *.blob.core.windows.net (different origin, read-only, expires in 10 min).
                           Chrome's PDF viewer needs scripts, so we don't sandbox here. *@
                        <object data="@SasUrl" type="application/pdf" style="width: 100%; height: 75vh;">
                            <div class="alert alert-warning">
                                <p>Prohlížeč nezvládl zobrazit PDF v rámu.</p>
                                <a href="@SasUrl" class="btn btn-primary" target="_blank" rel="noopener noreferrer">Otevřít v novém okně</a>
                            </div>
                        </object>
                    }
                    else if (isImage && SasUrl != null)
                    {
                        <div class="text-center">
                            <img src="@SasUrl" alt="@File.FileName" style="max-width: 100%; max-height: 75vh;" />
                        </div>
                    }
                    else if (isXml)
                    {
                        @if (XmlPretty != null)
                        {
                            <pre style="max-height: 75vh; overflow: auto;">@XmlPretty</pre>
                        }
                        else
                        {
                            <p class="text-muted">XML obsah se nepodařilo načíst.</p>
                        }
                    }
                    else
                    {
                        <div class="alert alert-secondary">
                            <p>Tento typ souboru (<code>@File.ContentType</code>) v prohlížeči nezobrazujeme z bezpečnostních důvodů.</p>
                            @if (SasUrl != null)
                            {
                                <a href="@SasUrl" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">Stáhnout</a>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (SasUrl != null)
                    {
                        <a href="@SasUrl" class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer">Stáhnout</a>
                    }
                    <button type="button" class="btn btn-secondary" @onclick="OnClose">Zavřít</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public ExternalOriginFile? File { get; set; }
    [Parameter] public string? SasUrl { get; set; }
    [Parameter] public string? XmlPretty { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
}
