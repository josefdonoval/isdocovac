@page "/investments"
@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Providers.Investments
@using Isdocovac.Services.Authentication
@using Isdocovac.Services.Investments
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject IOptionTradeProvider TradeProvider
@inject IOptionTradeCalculationService TradeCalc
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Investice — Opce</PageTitle>

<div class="container-fluid py-4" style="max-width: 1600px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="m-0">Investice — Opce</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="/investments/import">Import CSV</a>
            <a class="btn btn-primary" href="/investments/new">+ Nový obchod</a>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(-1)" disabled="@busy">‹</button>
        <div class="border rounded px-3 py-1 fw-semibold">@year</div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => ChangeYear(1)" disabled="@busy">›</button>
        @if (availableYears.Count > 0)
        {
            <span class="ms-3 small text-muted">
                Roky s daty: @string.Join(", ", availableYears)
            </span>
        }
    </div>

    @if (statusMessage != null)
    {
        <div class="alert alert-info">@statusMessage</div>
    }

    @if (trades != null && trades.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header py-2">Souhrn za rok @year</div>
            <div class="card-body py-3">
                <div class="row text-center g-3">
                    <div class="col-md-4">
                        <div class="small text-muted text-uppercase">Příjem (income)</div>
                        <div class="fs-5 fw-semibold text-success">@Fmt(totalIncomeUsd) <span class="text-muted small">USD</span></div>
                        <div class="fw-semibold text-success">@Fmt(totalIncomeCzk) <span class="text-muted small">CZK</span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted text-uppercase">Výdaj (expense)</div>
                        <div class="fs-5 fw-semibold text-danger">@Fmt(totalExpenseUsd) <span class="text-muted small">USD</span></div>
                        <div class="fw-semibold text-danger">@Fmt(totalExpenseCzk) <span class="text-muted small">CZK</span></div>
                    </div>
                    <div class="col-md-4">
                        <div class="small text-muted text-uppercase">Realized P/L</div>
                        <div class="fs-5 fw-semibold @PnlClass(totalPnlUsd)">@Fmt(totalPnlUsd) <span class="text-muted small">USD</span></div>
                        <div class="fw-semibold @PnlClass(totalPnlCzk)">@Fmt(totalPnlCzk) <span class="text-muted small">CZK</span></div>
                    </div>
                </div>
                <div class="form-text text-center mt-2">
                    Počítáno z @closedDealCount uzavřených obchodů (Code = C). Otevřené pozice nejsou započteny.
                </div>
            </div>
        </div>
    }

    @if (trades == null)
    {
        <p class="text-muted">Načítám…</p>
    }
    else if (trades.Count == 0)
    {
        <div class="alert alert-info">
            Žádné obchody pro rok @year. <a href="/investments/new">Přidat obchod</a>
            nebo <a href="/investments/import">importovat CSV</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle invest-table">
                <thead class="table-light">
                    <tr>
                        <th>Symbol</th>
                        <th>Date/Time</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">T.Price</th>
                        <th class="text-end">Proceeds USD</th>
                        <th class="text-end">Comm/Fee USD</th>
                        <th class="text-end">Basis USD</th>
                        <th class="text-end text-success">Income USD</th>
                        <th class="text-end text-danger">Expense USD</th>
                        <th class="text-end">Realized P/L USD</th>
                        <th>Code</th>
                        <th>CNB date</th>
                        <th class="text-end">USD/CZK</th>
                        <th class="text-end">Proceeds CZK</th>
                        <th class="text-end">Comm/Fee CZK</th>
                        <th class="text-end">Basis CZK</th>
                        <th class="text-end text-success">Income CZK</th>
                        <th class="text-end text-danger">Expense CZK</th>
                        <th class="text-end">Realized P/L CZK</th>
                        <th class="text-end">Akce</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in trades)
                    {
                        var ie = IncomeExpense(t);
                        <tr>
                            <td class="sym"><a href="@($"/investments/{t.Id}")" class="text-decoration-none">@t.Symbol</a></td>
                            <td>@t.TradeDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">@t.Quantity</td>
                            <td class="text-end">@FmtPrice(t.TradePrice)</td>
                            <td class="text-end">@Fmt(t.Proceeds)</td>
                            <td class="text-end">@Fmt(t.CommissionFee)</td>
                            <td class="text-end">@Fmt(t.Basis)</td>
                            <td class="text-end text-success">@FmtNullable(ie?.IncomeUsd)</td>
                            <td class="text-end text-danger">@FmtNullable(ie?.ExpenseUsd)</td>
                            <td class="text-end @PnlClass(t.RealizedPnl)">@FmtNullable(t.RealizedPnl)</td>
                            <td><span class="badge @CodeBadgeClass(t.Code)">@CodeLabel(t.Code)</span></td>
                            <td>@t.CnbDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-end">@FmtRate(t.FxRate)</td>
                            <td class="text-end">@Fmt(t.ProceedsCzk)</td>
                            <td class="text-end">@Fmt(t.CommissionFeeCzk)</td>
                            <td class="text-end">@Fmt(t.BasisCzk)</td>
                            <td class="text-end text-success">@FmtNullable(ie?.IncomeCzk)</td>
                            <td class="text-end text-danger">@FmtNullable(ie?.ExpenseCzk)</td>
                            <td class="text-end @PnlClass(t.RealizedPnlCzk)">@FmtNullable(t.RealizedPnlCzk)</td>
                            <td class="text-end text-nowrap">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/investments/{t.Id}")">Upravit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(t)">Smazat</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-semibold">
                        <td colspan="7" class="text-end">Σ za rok:</td>
                        <td class="text-end text-success">@Fmt(totalIncomeUsd)</td>
                        <td class="text-end text-danger">@Fmt(totalExpenseUsd)</td>
                        <td class="text-end @PnlClass(totalPnlUsd)">@Fmt(totalPnlUsd)</td>
                        <td colspan="6"></td>
                        <td class="text-end text-success">@Fmt(totalIncomeCzk)</td>
                        <td class="text-end text-danger">@Fmt(totalExpenseCzk)</td>
                        <td class="text-end @PnlClass(totalPnlCzk)">@Fmt(totalPnlCzk)</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private int year = DateTime.Now.Year;
    private bool busy;
    private Guid companyId;
    private List<OptionTrade>? trades;
    private List<int> availableYears = new();
    private decimal totalPnlUsd;
    private decimal totalPnlCzk;
    private decimal totalIncomeUsd;
    private decimal totalIncomeCzk;
    private decimal totalExpenseUsd;
    private decimal totalExpenseCzk;
    private int closedDealCount;
    private string? statusMessage;

    protected override async Task OnInitializedAsync()
    {
        var active = await CurrentCompanyAccessor.GetActiveCompanyIdAsync();
        if (active == null)
        {
            Nav.NavigateTo("/companies/new", forceLoad: true);
            return;
        }
        companyId = active.Value;

        availableYears = (await TradeProvider.ListYearsAsync(companyId)).ToList();
        if (availableYears.Count > 0 && !availableYears.Contains(year))
        {
            year = availableYears.First();
        }

        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        busy = true;
        try
        {
            var list = await TradeProvider.ListByYearAsync(companyId, year);
            trades = list.ToList();
            totalPnlUsd = trades.Sum(t => t.RealizedPnl ?? 0m);
            totalPnlCzk = trades.Sum(t => t.RealizedPnlCzk ?? 0m);

            var ies = trades.Select(IncomeExpense).Where(x => x != null).Select(x => x!.Value).ToList();
            closedDealCount = ies.Count;
            totalIncomeUsd = ies.Sum(x => x.IncomeUsd);
            totalIncomeCzk = ies.Sum(x => x.IncomeCzk);
            totalExpenseUsd = ies.Sum(x => x.ExpenseUsd);
            totalExpenseCzk = ies.Sum(x => x.ExpenseCzk);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ChangeYear(int delta)
    {
        year += delta;
        await ReloadAsync();
    }

    private async Task DeleteAsync(OptionTrade t)
    {
        var symbol = t.Symbol;
        await TradeProvider.DeleteAsync(t.Id);
        await TradeCalc.RecomputeMatchingAsync(companyId, symbol);
        statusMessage = $"Smazáno. Přepočítán P/L pro {symbol}.";
        await ReloadAsync();
    }

    private static string Fmt(decimal v) => v.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
    private static string FmtNullable(decimal? v) => v.HasValue ? Fmt(v.Value) : "—";
    private static string FmtPrice(decimal v) => v.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
    private static string FmtRate(decimal v) => v.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture);

    private static string PnlClass(decimal? v) => v switch
    {
        > 0m => "text-success",
        < 0m => "text-danger",
        _ => string.Empty,
    };

    private static string CodeLabel(OptionTradeCode c) => c == OptionTradeCode.Open ? "O" : "C";

    private static string CodeBadgeClass(OptionTradeCode c) => c == OptionTradeCode.Open
        ? "text-bg-secondary"
        : "text-bg-primary";

    // For a Close trade with realized P/L:
    //   Income  = gross sale proceeds (abs of close-trade Proceeds)
    //   Expense = matched open basis + close commission = Income - RealizedPnl
    // CZK uses the close-trade FX rate (consistent with broker-statement convention).
    private static (decimal IncomeUsd, decimal ExpenseUsd, decimal IncomeCzk, decimal ExpenseCzk)?
        IncomeExpense(OptionTrade t)
    {
        if (t.Code != OptionTradeCode.Close || !t.RealizedPnl.HasValue) return null;
        var incomeUsd = Math.Abs(t.Proceeds);
        var expenseUsd = incomeUsd - t.RealizedPnl.Value;
        var incomeCzk = Math.Abs(t.ProceedsCzk);
        var expenseCzk = incomeCzk - (t.RealizedPnlCzk ?? 0m);
        return (incomeUsd, expenseUsd, incomeCzk, expenseCzk);
    }
}
