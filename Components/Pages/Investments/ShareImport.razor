@page "/shares/import"
@using System.Globalization
@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Providers.Investments
@using Isdocovac.Services.Authentication
@using Isdocovac.Services.Investments
@using Isdocovac.Services.Investments.BrokerImport
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject IShareProvider ShareProvider
@inject IShareCalculationService ShareCalc
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Import obchodů akcií (CSV/TSV)</PageTitle>

<div class="container py-4" style="max-width: 1400px;">
    <h1>Import obchodů akcií</h1>
    <p class="text-muted">
        Vlož řádky oddělené tabulátorem (TSV) nebo čárkou (CSV) — formát se detekuje automaticky podle prvního datového řádku.
        Header je volitelný (přeskočí se).
        CNB kurzy se vždy dotahují čerstvě.
    </p>

    <div class="alert alert-warning small">
        Duplicity nejsou detekovány — pokud vložíš stejné řádky podruhé, založí se znovu. Před importem ověř.
    </div>

    @if (statusMessage != null)
    {
        <div class="alert @(statusSuccess ? "alert-success" : "alert-danger")">@statusMessage</div>
    }

    <div class="row">
        <div class="col-md-3 mb-3">
            <label class="form-label">Broker pro celý import *</label>
            <select class="form-select" @bind="selectedBroker">
                @foreach (var b in (Broker[])Enum.GetValues(typeof(Broker)))
                {
                    <option value="@b">@BrokerLabel.For(b)</option>
                }
            </select>
        </div>
        <div class="col-md-3 mb-3">
            <label class="form-label">Měna *</label>
            <select class="form-select" @bind="currency">
                <option value="USD">USD</option>
                <option value="EUR">EUR</option>
                <option value="GBP">GBP</option>
                <option value="CZK">CZK</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Vstupní data (TSV nebo CSV)</label>
        <textarea class="form-control font-monospace" rows="8" @bind="rawInput" @bind:event="oninput"
                  placeholder="Symbol,Date/Time,Quantity,T.Price,Proceeds,Comm/Fee,Basis,Realized P/L,Code"></textarea>
        <div class="form-text">Sloupce v očekávaném pořadí: Symbol, Date/Time, Quantity, T.Price, Proceeds, Comm/Fee, Basis, Realized P/L, Code (B/S), … (ostatní se ignorují). U CSV se akceptují i pole v uvozovkách (`"5,5800"`).</div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <button type="button" class="btn btn-outline-secondary" @onclick="ParseAsync" disabled="@busy">Náhled</button>
        <button type="button" class="btn btn-primary" @onclick="ImportAsync" disabled="@(busy || preview == null || preview.Count == 0 || preview.Any(p => p.Error != null))">
            @(busy ? "Importuji…" : $"Importovat ({preview?.Count(p => p.Error == null) ?? 0})")
        </button>
        <a class="btn btn-outline-secondary" href="/shares">Zpět</a>
    </div>

    @if (preview != null && preview.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-sm table-bordered small align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Symbol</th>
                        <th>Date/Time</th>
                        <th class="text-end">Qty</th>
                        <th class="text-end">T.Price</th>
                        <th class="text-end">Comm</th>
                        <th>Code</th>
                        <th class="text-end">Proceeds</th>
                        <th class="text-end">Basis</th>
                        <th>CNB date</th>
                        <th class="text-end">FX</th>
                        <th class="text-end">Basis CZK</th>
                        <th>Stav</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < preview.Count; i++)
                    {
                        var row = preview[i];
                        <tr class="@(row.Error != null ? "table-danger" : "")">
                            <td>@(i + 1)</td>
                            <td>@row.Symbol</td>
                            <td>@row.TradeDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="text-end">@FmtPrice(row.Quantity)</td>
                            <td class="text-end">@FmtPrice(row.TradePrice)</td>
                            <td class="text-end">@Fmt(row.CommissionFee)</td>
                            <td>@(row.Code == ShareTradeCode.Buy ? "B" : "S")</td>
                            <td class="text-end">@(row.Trade != null ? Fmt(row.Trade.Proceeds) : "—")</td>
                            <td class="text-end">@(row.Trade != null ? Fmt(row.Trade.Basis) : "—")</td>
                            <td>@(row.Trade != null ? row.Trade.CnbDate.ToString("yyyy-MM-dd") : "—")</td>
                            <td class="text-end">@(row.Trade != null ? FmtRate(row.Trade.FxRate) : "—")</td>
                            <td class="text-end">@(row.Trade != null ? Fmt(row.Trade.BasisCzk) : "—")</td>
                            <td>@(row.Error ?? "OK")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private string rawInput = string.Empty;
    private List<ImportRow>? preview;
    private bool busy;
    private string? statusMessage;
    private bool statusSuccess;
    private Guid companyId;
    private Broker selectedBroker = Broker.InteractiveBrokers;
    private string currency = "USD";

    protected override async Task OnInitializedAsync()
    {
        var active = await CurrentCompanyAccessor.GetActiveCompanyIdAsync();
        if (active == null)
        {
            Nav.NavigateTo("/companies/new", forceLoad: true);
            return;
        }
        companyId = active.Value;
    }

    private async Task ParseAsync()
    {
        busy = true;
        statusMessage = null;
        preview = null;
        try
        {
            if (LooksLikeDegiroExport(rawInput))
            {
                statusSuccess = false;
                statusMessage = "Vypadá to jako Degiro export (sloupce Date, Time, Product, ISIN, …). Tahle stránka čeká IBKR-style sloupce (Symbol, Date/Time, Quantity, …). Pro Degiro použij Import obchodů → vybrat DEGIRO + nahrát soubor (link: /imports/broker/new). Tam se navíc ukládá originál, deduplikuje se proti DB a podporuje se multi-měna (USD/EUR/PLN/CZK).";
                return;
            }

            var rows = ParseRaw(rawInput);
            foreach (var row in rows)
            {
                if (row.Error != null) continue;
                try
                {
                    var signedQty = row.Code == ShareTradeCode.Sell ? -Math.Abs(row.Quantity) : Math.Abs(row.Quantity);
                    row.Trade = new Share
                    {
                        CompanyId = companyId,
                        Symbol = row.Symbol,
                        TradeDateTime = row.TradeDateTime,
                        Quantity = signedQty,
                        TradePrice = row.TradePrice,
                        Currency = currency,
                        Broker = selectedBroker,
                        CommissionFee = row.CommissionFee,
                        Code = row.Code,
                    };
                    await ShareCalc.PrepareAsync(row.Trade);
                }
                catch (Exception ex)
                {
                    row.Error = $"FX/calc chyba: {ex.Message}";
                }
            }
            preview = rows;
            var ok = rows.Count(r => r.Error == null);
            statusSuccess = true;
            statusMessage = $"Načteno {rows.Count} řádků, OK: {ok}, chyby: {rows.Count - ok}.";
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Chyba parsování: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (preview == null) return;
        busy = true;
        statusMessage = null;
        try
        {
            var toInsert = preview
                .Where(r => r.Error == null && r.Trade != null)
                .Select(r => r.Trade!)
                .ToList();

            foreach (var t in toInsert)
            {
                t.TradeDateTime = ToUtc(t.TradeDateTime);
            }

            if (toInsert.Count == 0)
            {
                statusSuccess = false;
                statusMessage = "Žádné platné řádky k importu.";
                return;
            }

            await ShareProvider.CreateBulkAsync(toInsert);

            var symbols = toInsert.Select(t => t.Symbol).Distinct().ToList();
            foreach (var s in symbols)
            {
                await ShareCalc.RecomputeMatchingAsync(companyId, s);
            }

            Nav.NavigateTo("/shares");
        }
        catch (Exception ex)
        {
            statusSuccess = false;
            statusMessage = $"Chyba importu: {ex.Message}";
        }
        finally
        {
            busy = false;
        }
    }

    private static List<ImportRow> ParseRaw(string raw)
    {
        var result = new List<ImportRow>();
        if (string.IsNullOrWhiteSpace(raw)) return result;

        var lines = raw.Replace("\r\n", "\n").Split('\n', StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            if (string.IsNullOrWhiteSpace(line)) continue;
            var trimmed = line.Trim();

            // Auto-detect delimiter: tabs win if present (avoids splitting "Sep 5, 2024"-style
            // dates incorrectly); otherwise split as CSV (handles quoted decimal commas).
            List<string> cells = trimmed.Contains('\t')
                ? trimmed.Split('\t').ToList()
                : DegiroCsvParser.SplitCsv(trimmed);

            // Skip header rows from common broker exports.
            var first = cells.Count > 0 ? cells[0].Trim() : "";
            if (first.Equals("Symbol", StringComparison.OrdinalIgnoreCase)
                || first.Equals("Date", StringComparison.OrdinalIgnoreCase)
                || first.Equals("Trade Date", StringComparison.OrdinalIgnoreCase)
                || first.Equals("Datum", StringComparison.OrdinalIgnoreCase))
                continue;

            if (cells.Count < 9)
            {
                result.Add(new ImportRow { Error = $"Řádek má {cells.Count} sloupců, očekáváno alespoň 9." });
                continue;
            }

            try
            {
                var symbol = cells[0].Trim();
                var dateStr = cells[1].Trim();
                if (!TryParseDate(dateStr, out var dt))
                {
                    result.Add(new ImportRow { Symbol = symbol, Error = $"Neplatné Date/Time: '{dateStr}'." });
                    continue;
                }

                var qty = ParseDecimal(cells[2]);
                var price = ParseDecimal(cells[3]);
                var commission = ParseDecimal(cells[5]);
                var codeCell = cells[8].Trim().ToUpperInvariant();
                var code = codeCell switch
                {
                    "B" or "BUY" or "O" => ShareTradeCode.Buy,
                    "S" or "SELL" or "C" => ShareTradeCode.Sell,
                    _ => throw new FormatException($"Neznámý Code '{codeCell}' (očekáváno B nebo S).")
                };

                result.Add(new ImportRow
                {
                    Symbol = symbol,
                    TradeDateTime = dt,
                    Quantity = Math.Abs(qty),
                    TradePrice = price,
                    CommissionFee = Math.Abs(commission),
                    Code = code,
                });
            }
            catch (Exception ex)
            {
                result.Add(new ImportRow { Error = $"Parse chyba: {ex.Message}" });
            }
        }
        return result;
    }

    /// <summary>
    /// Heuristic: a paste is "Degiro-shaped" if it has the Degiro CSV header signature, or if
    /// data rows have ≥17 columns and the first cell parses as <c>dd-MM-yyyy</c>.
    /// </summary>
    private static bool LooksLikeDegiroExport(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return false;
        var lines = raw.Replace("\r\n", "\n").Split('\n', StringSplitOptions.RemoveEmptyEntries);
        foreach (var line in lines)
        {
            var t = line.Trim();
            if (t.Length == 0) continue;
            if (t.StartsWith("Date,Time,Product", StringComparison.OrdinalIgnoreCase)) return true;
            var cells = DegiroCsvParser.SplitCsv(t);
            if (cells.Count >= 17 && DateTime.TryParseExact(cells[0].Trim(),
                    "dd-MM-yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out _))
            {
                return true;
            }
            // Inspect at most a few lines.
            if (cells.Count >= 3) return false;
        }
        return false;
    }

    private static readonly string[] DateFormats =
    {
        "yyyy-MM-dd HH:mm:ss", "yyyy-MM-dd HH:mm", "yyyy-MM-dd",
        "dd-MM-yyyy HH:mm:ss", "dd-MM-yyyy HH:mm", "dd-MM-yyyy",
        "dd/MM/yyyy HH:mm:ss", "dd/MM/yyyy HH:mm", "dd/MM/yyyy",
        "dd.MM.yyyy HH:mm:ss", "dd.MM.yyyy HH:mm", "dd.MM.yyyy",
        "yyyy/MM/dd HH:mm:ss", "yyyy/MM/dd HH:mm", "yyyy/MM/dd",
        "MM/dd/yyyy HH:mm:ss", "MM/dd/yyyy HH:mm", "MM/dd/yyyy",
    };

    private static bool TryParseDate(string s, out DateTime dt)
    {
        var trimmed = s.Trim();
        if (DateTime.TryParseExact(trimmed, DateFormats,
                CultureInfo.InvariantCulture, DateTimeStyles.None, out dt))
            return true;
        return DateTime.TryParse(trimmed, CultureInfo.InvariantCulture, DateTimeStyles.None, out dt);
    }

    private static decimal ParseDecimal(string s)
    {
        var trimmed = s.Trim().Replace(",", ".");
        return decimal.Parse(trimmed, NumberStyles.Any, CultureInfo.InvariantCulture);
    }

    private static string Fmt(decimal v) => v.ToString("N2", CultureInfo.InvariantCulture);
    private static string FmtPrice(decimal v) => v.ToString("0.######", CultureInfo.InvariantCulture);
    private static string FmtRate(decimal v) => v.ToString("0.000", CultureInfo.InvariantCulture);

    private static DateTime ToUtc(DateTime dt) => dt.Kind switch
    {
        DateTimeKind.Utc => dt,
        DateTimeKind.Local => dt.ToUniversalTime(),
        _ => DateTime.SpecifyKind(dt, DateTimeKind.Local).ToUniversalTime(),
    };

    private class ImportRow
    {
        public string Symbol { get; set; } = string.Empty;
        public DateTime TradeDateTime { get; set; }
        public decimal Quantity { get; set; }
        public decimal TradePrice { get; set; }
        public decimal CommissionFee { get; set; }
        public ShareTradeCode Code { get; set; }
        public Share? Trade { get; set; }
        public string? Error { get; set; }
    }
}
