@page "/"

<PageTitle>Home</PageTitle>

<div class="hero">
    <h1>Welcome to Isdocovac</h1>
    <p>Upload, parse and sync ISDOC invoices across your connected sources.</p>
</div>

<div class="card-grid">
    <a class="feature-card" href="invoices">
        <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
        </div>
        <div class="feature-body">
            <h2>All Invoices</h2>
            <p>Browse and manage every invoice you've uploaded.</p>
        </div>
    </a>

    <a class="feature-card" href="invoices/create">
        <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
        </div>
        <div class="feature-body">
            <h2>Create Invoice</h2>
            <p>Start a new invoice from scratch.</p>
        </div>
    </a>

    <a class="feature-card" href="upload-invoice">
        <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
        </div>
        <div class="feature-body">
            <h2>Upload Invoice</h2>
            <p>Import ISDOC XML files into the system.</p>
        </div>
    </a>

    <a class="feature-card" href="isdoc/parsed">
        <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
        </div>
        <div class="feature-body">
            <h2>Parsed ISDOC</h2>
            <p>Review structured data extracted from uploads.</p>
        </div>
    </a>

    <a class="feature-card" href="fakturoid/staging">
        <div class="feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16.2A4.5 4.5 0 0 0 17.5 8h-1.8A7 7 0 1 0 4 14.9"/><path d="M12 12v9m-4-4 4 4 4-4"/></svg>
        </div>
        <div class="feature-body">
            <h2>Fakturoid Staging</h2>
            <p>Sync and stage invoices from Fakturoid.</p>
        </div>
    </a>
</div>

<footer class="page-footer">
    &copy; @DateTime.UtcNow.Year Isdocovac
</footer>
