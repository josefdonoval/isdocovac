@using Isdocovac.Models
@using Isdocovac.Models.Enums
@using Isdocovac.Providers
@using Isdocovac.Services.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject ICompanyProvider CompanyProvider
@inject ICurrentCompanyAccessor CurrentCompanyAccessor
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@implements IDisposable

<div class="brand">
    <a class="brand-link" href="/">
        <span class="brand-mark">I</span>
        <span class="brand-name">Isdocovac</span>
    </a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-list">
        @if (companies.Count > 0)
        {
            <div class="nav-section">Active company</div>
            <div class="px-3 pb-2">
                <select class="form-select form-select-sm" value="@activeCompanyId?.ToString()" @onchange="OnCompanyChanged">
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
                <div class="d-flex gap-2 mt-2">
                    <a class="btn btn-sm btn-outline-secondary flex-fill" href="/companies">Manage</a>
                    <a class="btn btn-sm btn-outline-primary" href="/companies/new" title="New company">+</a>
                </div>
            </div>
        }

        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"/></svg>
            <span>Home</span>
        </NavLink>

        <div class="nav-section">Faktury</div>

        <NavLink class="nav-link" href="invoices" Match="NavLinkMatch.All">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg>
            <span>All Invoices</span>
        </NavLink>

        <NavLink class="nav-link" href="invoices/create-outbound">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/></svg>
            <span>Vystavit fakturu</span>
        </NavLink>

        <div class="nav-section">Náklady</div>

        <NavLink class="nav-link" href="invoices/create-inbound">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M6 9l6-6 6 6M4 21h16"/></svg>
            <span>Vytvořit náklad</span>
        </NavLink>

        <div class="nav-section">Import Sources</div>

        <NavLink class="nav-link" href="upload-invoice">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            <span>Upload invoice</span>
        </NavLink>

        <NavLink class="nav-link" href="isdoc/parsed">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6"/></svg>
            <span>Parsed ISDOC</span>
        </NavLink>

        <NavLink class="nav-link" href="fakturoid/staging">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16.2A4.5 4.5 0 0 0 17.5 8h-1.8A7 7 0 1 0 4 14.9"/><path d="M12 12v9m-4-4 4 4 4-4"/></svg>
            <span>Fakturoid Staging</span>
        </NavLink>

        <div class="nav-section">Kontakty</div>

        <NavLink class="nav-link" href="contacts">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            <span>Kontakty</span>
        </NavLink>

        <div class="nav-section">Reporting</div>

        <NavLink class="nav-link" href="vat/monthly">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v4H4zM4 10h16v10H4z"/><path d="M8 14h8M8 17h5"/></svg>
            <span>@vatLabel</span>
        </NavLink>

        <NavLink class="nav-link" href="vat/company">
            <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"/><path d="M12 8v8M8 12h8"/></svg>
            <span>Company Profile</span>
        </NavLink>
    </nav>
</div>

@code {
    private string vatLabel = "Monthly VAT";
    private List<Company> companies = new();
    private Guid? activeCompanyId;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await RefreshAsync();
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        await RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAsync()
    {
        var userId = await CurrentCompanyAccessor.GetCurrentUserIdAsync();
        if (userId == null)
        {
            companies = new();
            activeCompanyId = null;
            return;
        }

        companies = (await CompanyProvider.ListByOwnerAsync(userId.Value)).ToList();
        var active = await CurrentCompanyAccessor.GetActiveCompanyAsync();
        activeCompanyId = active?.Id;
        vatLabel = active?.VatPeriod == VatPeriod.Quarterly ? "Quarterly VAT" : "Monthly VAT";
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (e.Value is string s && Guid.TryParse(s, out var id) && id != activeCompanyId)
        {
            await CurrentCompanyAccessor.SetActiveCompanyAsync(id);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
