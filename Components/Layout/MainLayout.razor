@inherits LayoutComponentBase
@inject NavigationManager Nav
@implements IDisposable

<div class="page">
    <AuthorizeView>
        <Authorized>
            <aside class="sidebar">
                <NavMenu />
            </aside>
        </Authorized>
    </AuthorizeView>

    <main>
        <header class="top-row">
            <div class="crumb">@PageLabel()</div>
            <AuthorizeView>
                <Authorized>
                    <div class="user-menu dropdown">
                        <button class="user-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <svg class="user-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
                            <span class="user-email">@context.User.Identity?.Name</span>
                            <svg class="user-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/auth/logout">Logout</a></li>
                        </ul>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="login-link" href="/auth/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => InvokeAsync(StateHasChanged);

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;

    private string PageLabel()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.Trim('/').ToLowerInvariant();
        return path switch
        {
            "" => "Home",
            "invoices" => "All Invoices",
            "invoices/create" => "Create Invoice",
            "upload-invoice" => "Upload Invoice",
            "isdoc/parsed" => "Parsed ISDOC",
            "fakturoid/staging" => "Fakturoid Staging",
            _ => path.Split('/')[0] is var seg
                ? string.Concat(seg[..1].ToUpperInvariant(), seg.AsSpan(1))
                : "Page"
        };
    }
}
